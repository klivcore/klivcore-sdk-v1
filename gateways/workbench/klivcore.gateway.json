{
  "schemaVersion": 1,
  "contractVersion": 1,
  "id": "workbench",
  "capabilities": [
    "workbench:read",
    "workbench:write"
  ],
  "routes": [
    {
      "id": "workbench",
      "path": "/",
      "title": "Workbench",
      "requiredCapabilities": [
        "workbench:read",
        "workbench:write"
      ],
      "services": [
        "api"
      ],
      "component": {
        "id": "workbench-main",
        "js": "ui/main.js",
        "css": "ui/main.css"
      }
    },
    {
      "id": "debug-bench-viewport-rgb-squares",
      "path": "/debug/bench-viewport/rgb-squares",
      "title": "Workbench debug: RGB squares",
      "requiredCapabilities": [
        "workbench:read",
        "workbench:write"
      ],
      "services": [
        "api"
      ],
      "component": {
        "id": "workbench-debug-bench-viewport-rgb-squares",
        "js": "ui/debug-loader.js",
        "css": "ui/debug-loader.css"
      }
    }
  ],
  "server": {
    "id": "api",
    "process": "server",
    "requiredCapabilities": [
      "workbench:read",
      "workbench:write"
    ],
    "allowedRequests": [
      {
        "method": "GET",
        "path": "/v1/bootstrap"
      },
      {
        "method": "GET",
        "pathPrefix": "/v1/vaults"
      },
      {
        "method": "HEAD",
        "pathPrefix": "/v1/vaults"
      },
      {
        "method": "PUT",
        "pathPrefix": "/v1/vaults"
      },
      {
        "method": "PATCH",
        "pathPrefix": "/v1/vaults"
      },
      {
        "method": "DELETE",
        "pathPrefix": "/v1/vaults"
      },
      {
        "method": "GET",
        "pathPrefix": "/v1/debug/assets"
      }
    ],
    "healthPath": "/health"
  },
  "processes": [
    {
      "role": "server",
      "entrypoint": "bin/server.js"
    }
  ],
  "agentTools": [
    {
      "command": "bench",
      "description": "Inspect, validate, create, and safely edit Workbench bench files",
      "entrypoint": "bin/bench.js"
    }
  ]
}
