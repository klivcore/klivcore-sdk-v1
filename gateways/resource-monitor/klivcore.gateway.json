{
  "schemaVersion": 1,
  "contractVersion": 1,
  "id": "resource-monitor",
  "capabilities": [
    "resource-monitor:read"
  ],
  "routes": [
    {
      "id": "resource-monitor",
      "path": "/",
      "title": "Resource Monitor",
      "requiredCapabilities": [
        "resource-monitor:read"
      ],
      "services": [
        "api"
      ],
      "component": {
        "id": "resource-monitor-main",
        "js": "ui/main.js",
        "css": "ui/main.css"
      }
    }
  ],
  "server": {
    "id": "api",
    "process": "server",
    "requiredCapabilities": [
      "resource-monitor:read"
    ],
    "allowedRequests": [
      {
        "method": "GET",
        "path": "/v1/observations"
      },
      {
        "method": "GET",
        "path": "/v1/observations/aggregates"
      },
      {
        "method": "GET",
        "path": "/v1/observations/listeners"
      }
    ],
    "healthPath": "/health"
  },
  "processes": [
    {
      "role": "server",
      "entrypoint": "bin/server.js"
    },
    {
      "role": "collector",
      "entrypoint": "bin/collector.js"
    }
  ]
}
